{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/receipt",
  "$defs": {
    "command": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "argv",
        "timeout_seconds"
      ],
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F[0-9]{3,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "acceptance"
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "file",
            "symlink",
            "deleted"
          ]
        },
        "mode": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "index": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "minLength": 1
              },
              "oid": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
              },
              "stage": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              }
            },
            "required": [
              "mode",
              "oid",
              "stage"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "path",
        "kind",
        "mode",
        "sha256",
        "index"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "policy": {
          "const": "git-source-v1"
        },
        "layout": {
          "enum": [
            "visible",
            "hidden"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "policy",
        "layout",
        "entries",
        "sha256"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "feature_id": {
          "type": "string",
          "pattern": "^F[0-9]{3,}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "criteria_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "required_commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "feature_id",
        "attempt",
        "contract",
        "criteria_sha256",
        "snapshot",
        "required_commands"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "feature_id": {
          "type": "string",
          "pattern": "^F[0-9]{3,}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "criteria_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "run_id",
        "feature_id",
        "attempt",
        "criteria_sha256",
        "snapshot_sha256"
      ],
      "additionalProperties": false
    },
    "log": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-z]+-[0-9]+\\.(stdout|stderr)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "source": {
          "const": "runner-subprocess-v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "exit_code": {
          "type": "integer"
        },
        "timed_out": {
          "type": "boolean"
        },
        "launch_error": {
          "type": "string"
        },
        "stdout": {
          "$ref": "#/$defs/log"
        },
        "stderr": {
          "$ref": "#/$defs/log"
        }
      },
      "required": [
        "binding",
        "source",
        "command",
        "exit_code",
        "timed_out",
        "launch_error",
        "stdout",
        "stderr"
      ],
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "index",
              "status",
              "reason",
              "evidence"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "binding",
        "criteria"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "run": {
          "$ref": "#/$defs/run"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outcome"
          },
          "minItems": 1
        },
        "evaluator_command": {
          "$ref": "#/$defs/outcome"
        },
        "evaluation": {
          "$ref": "#/$defs/evaluation"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role_boundary": {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "boundary_required_json": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "boundary_json": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "changes_json": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "scope_json": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "version",
            "boundary_required_json",
            "boundary_json",
            "changes_json",
            "scope_json"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "run",
        "checks",
        "evaluator_command",
        "evaluation",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
